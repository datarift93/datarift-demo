# Copy to .env.local and fill in. Never commit real values.
# Local values are printed by `supabase status` after `supabase start`
# (PUBLISHABLE_KEY and SECRET_KEY).

# Public (safe in the browser; RLS protects the data)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only: bypasses RLS. Never expose to the browser, never prefix with NEXT_PUBLIC_
SUPABASE_SECRET_KEY=
