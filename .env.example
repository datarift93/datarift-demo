# Copy to .env.local and fill in. Never commit real values.
# Local values are printed by `supabase status` after `supabase start`.

# Public (safe in the browser; RLS protects the data)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only: never expose to the browser, never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
